.root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Dream.otf?fileID=12800000&guid=28850c0e46d59fc49b596723e4c16987&type=3#Dream");
}

.background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: resource("original_forest_bg");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgb(3, 8, 10);
}

.vignette {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 8, 10, 0.36);
}

.content {
    position: absolute;
    top: 8%;
    left: 5%;
    right: 5%;
    align-items: center;
}

.title-logo {
    width: 84%;
    max-width: 1180px;
    height: 240px;
    background-image: url("project:///Assets/Art/Title/RoamingTitleNew.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    margin-bottom: 8px;
}

.title-rule {
    width: 26%;
    min-width: 180px;
    max-width: 260px;
    height: 3px;
    background-color: rgba(173, 207, 113, 0.82);
    margin-bottom: 24px;
}

.menu-list {
    width: 100%;
    align-items: center;
}

.menu-item {
    width: 300px;
    height: 55px;
    margin-bottom: 12px;
    justify-content: center;
    align-items: center;
    background-image: resource("btns/btn_normal");
    unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.menu-item-spaced {
    margin-top: 8px;
}

.menu-item.selected,
.menu-item:hover {
    background-image: resource("btns/btn_hover");
}

.menu-label {
    color: rgb(244, 235, 211);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.version {
    position: absolute;
    left: 2%;
    bottom: 3%;
    color: rgba(244, 235, 211, 0.9);
    font-size: 16px;
    letter-spacing: 1px;
}

.options-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 8, 10, 0.88);
}

.options-panel {
    width: 390px;
    padding: 30px;
    align-items: center;
    background-color: rgba(15, 24, 20, 0.96);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(173, 207, 113);
    border-bottom-color: rgb(173, 207, 113);
    border-left-color: rgb(173, 207, 113);
    border-right-color: rgb(173, 207, 113);
}

.options-title {
    margin-bottom: 24px;
    color: rgb(248, 239, 215);
    font-size: 38px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.options-field {
    width: 330px;
    margin-bottom: 16px;
    color: rgb(244, 235, 211);
    font-size: 15px;
}

.options-value {
    margin-top: -12px;
    margin-bottom: 18px;
    color: rgb(173, 207, 113);
    font-size: 14px;
}

.options-button {
    width: 260px;
    height: 56px;
    color: rgb(244, 235, 211);
    font-size: 16px;
    -unity-font-style: bold;
    background-image: resource("btns/btn_normal");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.options-button:hover {
    background-image: resource("btns/btn_hover");
}

.options-hint {
    margin-top: 16px;
    color: rgba(244, 235, 211, 0.8);
    font-size: 12px;
    letter-spacing: 1px;
}

.options-root {
    padding-left: 5%;
    padding-right: 5%;
}

.options-scroll {
    width: 100%;
    max-width: 480px;
    max-height: 88%;
}

.options-panel {
    width: 100%;
    min-width: 0;
    max-width: none;
    padding: 24px 7%;
}

.options-field {
    width: 100%;
}

.options-button {
    width: 100%;
    max-width: 300px;
}

.options-title {
    font-size: 34px;
    -unity-text-align: middle-center;
}

.fireflies {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    picking-mode: ignore;
}

.firefly {
    position: absolute;
    width: 24px;
    height: 24px;
    justify-content: center;
    align-items: center;
    background-image: resource("firefly_glow");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.firefly-small {
    width: 16px;
    height: 16px;
    background-color: rgba(0, 0, 0, 0);
}

.firefly-core {
    width: 4px;
    height: 4px;
    background-color: rgb(255, 230, 0);
    border-radius: 50%;
}

.firefly-small .firefly-core {
    width: 3px;
    height: 3px;
}

.firefly-left-1 {
    left: 8%;
    top: 17%;
}

.firefly-left-2 {
    left: 19%;
    top: 30%;
}

.firefly-left-3 {
    left: 12%;
    top: 48%;
}

.firefly-left-4 {
    left: 23%;
    top: 62%;
}

.firefly-left-5 {
    left: 7%;
    top: 76%;
}

.firefly-left-6 {
    left: 18%;
    top: 87%;
}

.firefly-right-1 {
    right: 16%;
    top: 20%;
}

.firefly-right-2 {
    right: 8%;
    top: 39%;
}

.firefly-right-3 {
    right: 22%;
    top: 54%;
}

.firefly-right-4 {
    right: 12%;
    top: 67%;
}

.firefly-right-5 {
    right: 6%;
    top: 82%;
}

.firefly-right-6 {
    right: 20%;
    top: 91%;
}

/* Folhas nas margens da opção atualmente selecionada. */
.menu-item {
    overflow: visible;
}

.menu-leaf {
    display: none;
    position: absolute;
    top: 50%;
    width: 40px;
    height: 40px;
    translate: 0 -50%;
    background-image: url("project:///Assets/Art/MainMenu/LeafMenu.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: ignore;
}

.menu-leaf-left {
    left: -14px;
}

.menu-leaf-right {
    right: -14px;
}

/* Repete o marcador visual mostrado na referência, apenas na opção ativa. */
.menu-item.selected .menu-leaf,
.menu-item:hover .menu-leaf {
    display: flex;
}
