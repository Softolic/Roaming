.root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    -unity-font-definition: url("project:///Assets/Fonts/Dream.otf");
}

.background {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: resource("menu_bg");
    -unity-background-scale-mode: scale-and-crop;
}

.vignette {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(3, 8, 10, 0.36);
}

.content {
    position: absolute;
    top: 8%;
    left: 5%;
    right: 5%;
    align-items: center;
}

.title {
    color: rgb(248, 239, 215);
    font-size: 76px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.title-rule {
    width: 26%;
    min-width: 180px;
    max-width: 260px;
    height: 3px;
    background-color: rgba(173, 207, 113, 0.82);
    margin-bottom: 24px;
}

.menu-list {
    width: 100%;
    align-items: center;
}

.menu-item {
    width: 300px;
    height: 55px;
    margin-bottom: 12px;
    justify-content: center;
    align-items: center;
    background-image: resource("btns/btn_normal");
    unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px; 
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.menu-item-spaced {
    margin-top: 8px;
}

.menu-item.selected,
.menu-item:hover {
    background-image: resource("btns/btn_hover");
}

.menu-label {
    color: rgb(244, 235, 211);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.version {
    position: absolute;
    left: 2%;
    bottom: 3%;
    color: rgba(244, 235, 211, 0.9);
    font-size: 16px;
    letter-spacing: 1px;
}