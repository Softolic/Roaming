
.mission-root {
    position: absolute;
    top: 5%;
    left: 4%;
    right: 4%;
    align-items: center;
    picking-mode: ignore;
    -unity-font-definition: url("project:///Assets/Fonts/Dream.otf");
}
.mission-text {
    max-width: 100%;
    padding: 10px 18px;
    color: rgb(248, 239, 215);
    background-color: rgba(3, 8, 10, 0.65);
    border-bottom-width: 2px;
    border-bottom-color: rgba(173, 207, 113, 0.85);
    border-radius: 5px;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85);
    picking-mode: ignore;
}
