.chapter-intro-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("project:///Assets/Fonts/Dream.otf");
    picking-mode: ignore;
}

.chapter-card {
    align-items: center;
    opacity: 0;
}

.chapter-name {
    color: rgb(245, 241, 232);
    font-size: 54px;
    letter-spacing: 15px;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.8);
}

.divider {
    width: 220px;
    height: 1px;
    margin-top: 14px;
    margin-bottom: 13px;
    background-color: rgba(245, 241, 232, 0.7);
}

.chapter-subtitle {
    color: rgba(235, 230, 220, 0.9);
    font-size: 19px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}
