.pause-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.62);
    -unity-font-definition: url("project:///Assets/Fonts/Dream.otf");
}

.pause-panel {
    width: 360px;
    align-items: center;
}

.pause-title {
    margin-bottom: 26px;
    color: rgb(248, 239, 215);
    font-size: 42px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-button {
    width: 300px;
    height: 64px;
    margin-bottom: 12px;
    color: rgb(244, 235, 211);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-image: resource("btns/btn_normal");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16px;
    -unity-slice-top: 16px;
    -unity-slice-right: 16px;
    -unity-slice-bottom: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.pause-button:hover {
    background-image: resource("btns/btn_hover");
}

.pause-hint {
    margin-top: 18px;
    color: rgba(244, 235, 211, 0.8);
    font-size: 13px;
    letter-spacing: 1px;
}