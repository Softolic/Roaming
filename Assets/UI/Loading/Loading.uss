.loading-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(10, 12, 16);
    -unity-font-definition: url("project:///Assets/Fonts/Dream.otf");
}

.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(20, 26, 34, 0.35);
}

.content {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    align-items: center;
}

.game-title {
    color: rgb(245, 241, 232);
    font-size: 58px;
    letter-spacing: 16px;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.9);
}

.destination {
    margin-top: 10px;
    color: rgba(220, 214, 203, 0.7);
    font-size: 14px;
    letter-spacing: 5px;
    -unity-text-align: middle-center;
}

.loading-area {
    position: absolute;
    left: 50%;
    bottom: 13%;
    width: 390px;
    margin-left: -195px;
    align-items: center;
}

.loading-text {
    width: 390px;
    color: rgb(240, 235, 225);
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.progress-track {
    width: 310px;
    height: 2px;
    margin-top: 16px;
    background-color: rgba(245, 241, 232, 0.18);
}

.progress-fill {
    width: 0%;
    height: 2px;
    background-color: rgb(245, 241, 232);
}
